# Streamlit decision-tool interface, served at xploring.tristanfaure.com.
# Data is pre-prepared (interface/data/*.parquet, tracked in the repo) —
# no Spark needed at runtime.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir streamlit==1.49.1 pandas numpy matplotlib \
    scikit-learn h3 folium
COPY interface/ interface/
EXPOSE 8501
CMD ["streamlit", "run", "interface/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
